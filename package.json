{
  "name": "cv-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-resume-pdf.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prebuild": "node scripts/generate-resume-pdf.mjs",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "npm run build && wrangler dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "12",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/recursive": "^5.3.0",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^5.11.0",
    "pdfkit": "^0.19.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "wrangler": "^4.113.0"
  }
}
