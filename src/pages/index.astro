---
import CommandMenu from "@/components/CommandMenu.astro";
import Education from "@/components/Education.astro";
import Header from "@/components/Header.astro";
import Projects from "@/components/Projects.astro";
import Skills from "@/components/Skills.astro";
import Summary from "@/components/Summary.astro";
import UtilityBar from "@/components/UtilityBar.astro";
import WorkExperience from "@/components/WorkExperience.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { RESUME_DATA, RESUME_DATA_ID, UI_COPY } from "@/data/resume";

const title = UI_COPY.en.pageTitle;
const commandLinks = [
  ...(RESUME_DATA.personalWebsiteUrl
    ? [{ url: RESUME_DATA.personalWebsiteUrl, title: "Personal Website (arrazyfathan.com)" }]
    : []),
  ...RESUME_DATA.contact.social.map((social) => ({
    url: social.url,
    title: social.name,
  })),
];
---

<BaseLayout
  title={title}
  description={RESUME_DATA.description}
  ogDescription={RESUME_DATA.ogDescription}
>
  <main
    class="mx-auto w-full max-w-[740px] px-5 pb-16 pt-6 sm:px-8 sm:pt-10 print:max-w-none print:px-0 print:py-0"
    id="main-content"
  >
    <UtilityBar websiteUrl={RESUME_DATA.personalWebsiteUrl} />

    <div class="space-y-8 print:space-y-4" aria-label="Resume Content">
      <Header resume={RESUME_DATA} resumeId={RESUME_DATA_ID} />
      <Summary summary={RESUME_DATA.summary} summaryId={RESUME_DATA_ID.summary} />
      <WorkExperience work={RESUME_DATA.work} workId={RESUME_DATA_ID.work} />
      <Projects projects={RESUME_DATA.projects} projectsId={RESUME_DATA_ID.projects} />
      <Skills skills={RESUME_DATA.skills} />
      <Education education={RESUME_DATA.education} educationId={RESUME_DATA_ID.education} />
    </div>

    <CommandMenu
      name={RESUME_DATA.name}
      location={RESUME_DATA.location}
      email={RESUME_DATA.contact.email}
      links={commandLinks}
    />
  </main>
</BaseLayout>
