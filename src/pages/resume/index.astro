---
import Education from "@/components/Education.astro";
import Header from "@/components/Header.astro";
import Icon from "@/components/Icon.astro";
import Projects from "@/components/Projects.astro";
import Skills from "@/components/Skills.astro";
import Summary from "@/components/Summary.astro";
import WorkExperience from "@/components/WorkExperience.astro";
import { RESUME_DATA } from "@/data/resume";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = `${RESUME_DATA.name} | Résumé`;
---

<BaseLayout title={title} description={RESUME_DATA.description} canonical="/resume/">
  <a class="skip-link" href="#main-content">Skip to résumé</a>
  <div class="resume-toolbar print:hidden">
    <a href="/">← Portfolio</a>
    <a href="/ar-razy-fathan-rabbani-cv.pdf" download="ar-razy-fathan-rabbani-cv.pdf">
      <Icon name="download" class="size-4" />
      Download PDF
    </a>
  </div>

  <main class="resume-page container relative mx-auto scroll-my-12 overflow-auto p-4 print:p-11 md:p-16" id="main-content">
    <section class="mx-auto w-full max-w-2xl space-y-8 print:space-y-4" aria-label="Résumé content">
      <Header resume={RESUME_DATA} />

      <div class="reveal-stagger space-y-8 print:space-y-4">
        <Summary summary={RESUME_DATA.summary} />
        <WorkExperience work={RESUME_DATA.work} />
        <Education education={RESUME_DATA.education} />
        <Skills skills={RESUME_DATA.skills} />
        <Projects projects={RESUME_DATA.projects} />
      </div>
    </section>
  </main>
</BaseLayout>
