---
interface Props {
  title?: string;
  id?: string;
  delay?: string;
  class?: string;
}

const { title, id, delay = "0ms", class: className = "" } = Astro.props;
---

<section
  class:list={[
    "cv-stagger flex min-h-0 flex-col gap-y-4 border-t border-[var(--line)] pt-7 print:gap-y-2 print:pt-4",
    className,
  ]}
  style={`animation-delay: ${delay};`}
>
  {title && (
    <h2
      class="font-serif text-[16px] font-normal italic text-[var(--muted)] print:text-[12.5px]"
      id={id}
    >
      {title}
    </h2>
  )}
  <slot />
</section>
