---
interface Props {
  title?: string;
  titleId?: string;
  id?: string;
  delay?: string;
  class?: string;
}

const { title, titleId, id, delay = "0ms", class: className = "" } = Astro.props;
---

<section
  class:list={[
    "cv-stagger flex min-h-0 flex-col gap-y-4 border-t border-[var(--line)] pt-7 print:gap-y-2 print:pt-4",
    className,
  ]}
  style={`animation-delay: ${delay};`}
>
  {title && (
    <h2
      class="font-display text-[20px] font-bold tracking-[-0.02em] text-[var(--ink)] sm:text-[21px] print:text-[14px]"
      id={id}
    >
      {titleId ? (
        <>
          <span data-lang-view="en">{title}</span>
          <span data-lang-view="id">{titleId}</span>
        </>
      ) : (
        title
      )}
    </h2>
  )}
  <slot />
</section>
