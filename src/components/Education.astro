---
import Section from "./Section.astro";
import { UI_COPY, type ResumeData } from "@/data/resume";

interface Props {
  education: ResumeData["education"];
  educationId: ResumeData["education"];
}

const { education, educationId } = Astro.props;
---

<Section
  title={UI_COPY.en.sections.education}
  titleId={UI_COPY.id.sections.education}
  id="education-section"
  delay="250ms"
>
  <div class="space-y-4 print:space-y-2" aria-labelledby="education-section">
    {education.map((item, idx) => {
      const localized = educationId[idx] ?? item;
      return (
        <article class="cv-avoid-break space-y-1">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
            <h3 class="font-display text-[17px] font-bold tracking-[-0.015em] text-[var(--ink)] print:text-[13px]">
              {item.school}
            </h3>
            <span
              class="font-mono text-[12.5px] tabular-nums text-[var(--muted)] print:text-[10.5px]"
              aria-label={`Period: ${item.start} to ${item.end}`}
            >
              {item.start} — {item.end}
            </span>
          </div>
          <p class="text-[14.5px] text-[var(--ink-2)] print:text-[11px]">
            <span data-lang-view="en">
              {item.degree}
              {item.gpa && (
                <span class="font-mono text-[12.5px] text-[var(--muted)] print:text-[10px]">
                  {" "}· {UI_COPY.en.gpa} {item.gpa}
                </span>
              )}
            </span>
            <span data-lang-view="id">
              {localized.degree}
              {localized.gpa && (
                <span class="font-mono text-[12.5px] text-[var(--muted)] print:text-[10px]">
                  {" "}· {UI_COPY.id.gpa} {localized.gpa}
                </span>
              )}
            </span>
          </p>
        </article>
      );
    })}
  </div>
</Section>
