---
import Section from "./Section.astro";

interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<Section title="Summary" id="about-section" delay="50ms">
  <p
    class="text-justify text-[15px] leading-[1.72] text-[var(--ink-2)] print:text-[11px] print:leading-[1.55]"
    aria-labelledby="about-section"
  >
    {summary}
  </p>
</Section>
