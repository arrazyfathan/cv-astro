---
import Icon from "./Icon.astro";
import Section from "./Section.astro";
import { UI_COPY, type ResumeData } from "@/data/resume";

interface Props {
  work: ResumeData["work"];
  workId: ResumeData["work"];
}

const { work, workId } = Astro.props;
---

<Section
  title={UI_COPY.en.sections.experience}
  titleId={UI_COPY.id.sections.experience}
  id="work-experience"
  delay="100ms"
>
  <div class="space-y-8 print:space-y-4" aria-labelledby="work-experience">
    {work.map((item, idx) => {
      const localized = workId[idx] ?? item;
      return (
        <article class="cv-avoid-break space-y-2.5 print:space-y-1.5">
          <div class="space-y-0.5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
              <h3 class="font-display text-[17px] font-bold tracking-[-0.015em] text-[var(--ink)] print:text-[13px]">
                {item.link ? (
                  <a
                    href={item.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-1 transition-colors hover:text-[var(--accent)]"
                    aria-label={`${item.company} website`}
                  >
                    <span>{item.company}</span>
                    <Icon
                      name="arrow-up-right"
                      class="size-3.5 text-[var(--quiet)] transition-transform duration-200 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-[var(--accent)] print:hidden"
                    />
                  </a>
                ) : (
                  <span>{item.company}</span>
                )}
              </h3>
              <span
                class="font-mono text-[12.5px] tabular-nums text-[var(--muted)] print:text-[10.5px]"
                aria-label={`Employment period: ${item.start} to ${item.end ?? "Present"}`}
              >
                <span data-lang-view="en">
                  {item.start} — {item.end ?? UI_COPY.en.present}
                </span>
                <span data-lang-view="id">
                  {localized.start} — {localized.end ?? UI_COPY.id.present}
                </span>
              </span>
            </div>

            <p class="text-[14.5px] font-medium text-[var(--ink-2)] print:text-[11px]">
              <span data-lang-view="en">
                {item.title}
                {item.location && (
                  <span class="font-normal text-[var(--muted)]"> · {item.location}</span>
                )}
              </span>
              <span data-lang-view="id">
                {localized.title}
                {localized.location && (
                  <span class="font-normal text-[var(--muted)]"> · {localized.location}</span>
                )}
              </span>
            </p>
          </div>

          <p class="text-pretty text-[14.5px] leading-[1.65] text-[var(--ink-2)] print:text-[10.5px] print:leading-[1.5]">
            <span data-lang-view="en">{item.description.paragraph}</span>
            <span data-lang-view="id">{localized.description.paragraph}</span>
          </p>

          <ul
            data-lang-view="en"
            class="list-disc space-y-1.5 pl-4 text-[14.5px] leading-[1.65] text-[var(--ink-2)] marker:text-[var(--quiet)] print:space-y-1 print:text-[10.5px] print:leading-[1.45]"
          >
            {item.description.bullets.map((bullet) => (
              <li class="pl-1 text-pretty">{bullet}</li>
            ))}
          </ul>

          <ul
            data-lang-view="id"
            class="list-disc space-y-1.5 pl-4 text-[14.5px] leading-[1.65] text-[var(--ink-2)] marker:text-[var(--quiet)] print:space-y-1 print:text-[10.5px] print:leading-[1.45]"
          >
            {localized.description.bullets.map((bullet) => (
              <li class="pl-1 text-pretty">{bullet}</li>
            ))}
          </ul>

          {item.badges.length > 0 && (
            <ul class="flex flex-wrap gap-1.5 pt-1 print:pt-0.5" aria-label="Primary stack">
              {item.badges.map((badge) => (
                <li class="rounded-md border border-[var(--line)] bg-[var(--sunken)] px-2 py-0.5 font-mono text-[11px] font-medium text-[var(--muted)] print:px-1.5 print:py-0 print:text-[9px]">
                  {badge}
                </li>
              ))}
            </ul>
          )}
        </article>
      );
    })}
  </div>
</Section>
