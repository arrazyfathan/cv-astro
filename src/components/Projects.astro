---
import Icon from "./Icon.astro";
import Section from "./Section.astro";
import { UI_COPY, type ResumeData } from "@/data/resume";

interface Props {
  projects: ResumeData["projects"];
  projectsId: ResumeData["projects"];
}

const { projects, projectsId } = Astro.props;
---

<Section
  title={UI_COPY.en.sections.projects}
  titleId={UI_COPY.id.sections.projects}
  id="selected-projects"
  delay="150ms"
>
  <div aria-labelledby="selected-projects">
    {projects.map((project, idx) => {
      const localized = projectsId[idx] ?? project;
      const href = project.link?.href;
      const label = project.link?.label;
      return (
        <article class="cv-avoid-break border-b border-[var(--line)] py-4 first:pt-0 last:border-b-0 last:pb-0 print:py-2.5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="font-display text-[17px] font-bold tracking-[-0.01em] text-[var(--ink)] print:text-[12.5px]">
              {href ? (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-1 transition-colors hover:text-[var(--accent)]"
                  aria-label={`${project.title} (${label})`}
                >
                  <span>{project.title}</span>
                  <Icon
                    name="arrow-up-right"
                    class="size-3.5 text-[var(--quiet)] transition-transform duration-200 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-[var(--accent)] print:hidden"
                  />
                </a>
              ) : (
                <span>{project.title}</span>
              )}
            </h3>

            {href ? (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-[11.5px] text-[var(--muted)] transition-colors hover:text-[var(--accent)] print:text-[9.5px]"
              >
                {label}
              </a>
            ) : (
              label && (
                <span class="font-mono text-[11px] text-[var(--quiet)] print:text-[9.5px]">
                  {label}
                </span>
              )
            )}
          </div>

          <p class="mt-1.5 text-pretty text-[14.5px] leading-[1.65] text-[var(--ink-2)] print:mt-0.5 print:text-[10.5px] print:leading-[1.45]">
            <span data-lang-view="en">{project.description}</span>
            <span data-lang-view="id">{localized.description}</span>
          </p>

          {project.techStack.length > 0 && (
            <ul class="mt-2.5 flex flex-wrap gap-1.5 print:mt-1.5" aria-label="Technologies used">
              {project.techStack.map((tag) => (
                <li class="rounded-md border border-[var(--line)] bg-[var(--sunken)] px-2 py-0.5 font-mono text-[11px] text-[var(--muted)] print:px-1.5 print:py-0 print:text-[8.5px]">
                  {tag}
                </li>
              ))}
            </ul>
          )}
        </article>
      );
    })}
  </div>
</Section>
