---
import Icon from "./Icon.astro";

interface CommandLink {
  title: string;
  url: string;
}

interface Props {
  links: CommandLink[];
}

const { links } = Astro.props;
---

<div data-command-menu>
  <p class="fixed bottom-0 left-0 right-0 hidden border-t bg-white p-1 text-center text-sm text-gray-500 xl:block print:hidden">
    Press{" "}
    <kbd class="pointer-events-none inline-flex h-5 select-none items-center gap-1 rounded border bg-gray-100 px-1.5 font-mono text-[10px] font-medium text-gray-500 opacity-100">
      <span class="text-xs" data-command-modifier>Ctrl</span>+J
    </kbd>{" "}
    to open the command menu
  </p>

  <button
    type="button"
    class="cmd-fab fixed bottom-4 right-4 flex size-12 items-center justify-center rounded-full border bg-white shadow-2xl hover:bg-gray-100 xl:hidden print:hidden"
    aria-label="Open command menu"
    aria-controls="command-menu-dialog"
    aria-expanded="false"
    data-command-trigger
  >
    <Icon name="command" class="size-6" />
  </button>

  <div class="cmd-overlay fixed inset-0 z-50 flex items-start justify-center bg-black/40 px-4 pt-[12vh] print:hidden" role="presentation" hidden data-command-overlay>
    <div
      id="command-menu-dialog"
      class="cmd-dialog w-full max-w-lg overflow-hidden rounded-lg border bg-white shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-label="Command menu"
      data-command-dialog
    >
      <div class="flex items-center border-b px-3">
        <Icon name="command" class="mr-2 size-4 shrink-0 opacity-50" />
        <input
          class="h-12 w-full bg-transparent text-sm outline-none placeholder:text-gray-500"
          placeholder="Type a command or search..."
          autocomplete="off"
          data-command-search
        />
        <button type="button" class="cmd-close rounded p-1 text-gray-500 hover:bg-gray-100" aria-label="Close command menu" data-command-close>
          <Icon name="x" class="size-4" />
        </button>
      </div>

      <div class="max-h-[320px] overflow-y-auto p-2">
        <div class="px-2 py-1.5 font-mono text-xs font-medium uppercase tracking-wider text-gray-500">Actions</div>
        <a href="/ar-razy-fathan-rabbani-cv.pdf" download="ar-razy-fathan-rabbani-cv.pdf" class="cmd-item flex w-full items-center gap-2 rounded-sm px-2 py-2 text-left text-sm hover:bg-gray-100" data-command-download>
          <Icon name="download" class="size-4" />
          <span>Download PDF</span>
        </a>

        <div class="mt-2 border-t pt-2">
          <div class="px-2 py-1.5 font-mono text-xs font-medium uppercase tracking-wider text-gray-500">Links</div>
          <p class="px-2 py-6 text-center text-sm text-gray-500" hidden data-command-empty>No results found.</p>
          {links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="cmd-item flex w-full items-center gap-2 rounded-sm px-2 py-2 text-left text-sm hover:bg-gray-100"
              data-command-link
              data-command-title={link.title.toLowerCase()}
            >
              <Icon name="external-link" class="size-4" />
              <span>{link.title}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const menus = document.querySelectorAll<HTMLElement>("[data-command-menu]");

  menus.forEach((menu) => {
    const trigger = menu.querySelector<HTMLButtonElement>("[data-command-trigger]");
    const overlay = menu.querySelector<HTMLElement>("[data-command-overlay]");
    const dialog = menu.querySelector<HTMLElement>("[data-command-dialog]");
    const closeButton = menu.querySelector<HTMLButtonElement>("[data-command-close]");
    const searchInput = menu.querySelector<HTMLInputElement>("[data-command-search]");
    const emptyState = menu.querySelector<HTMLElement>("[data-command-empty]");
    const modifier = menu.querySelector<HTMLElement>("[data-command-modifier]");
    const links = Array.from(menu.querySelectorAll<HTMLElement>("[data-command-link]"));

    if (!trigger || !overlay || !dialog || !closeButton || !searchInput || !emptyState) return;

    const isMac = window.navigator.userAgent.includes("Mac");
    if (modifier) modifier.textContent = isMac ? "⌘" : "Ctrl";

    const filterLinks = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      links.forEach((link) => {
        const matches = !query || link.dataset.commandTitle?.includes(query);
        link.hidden = !matches;
        if (matches) visibleCount += 1;
      });

      emptyState.hidden = visibleCount !== 0;
    };

    const openMenu = () => {
      if (closeTimer !== null) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      overlay.classList.remove("closing");
      overlay.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      searchInput.value = "";
      filterLinks();
      requestAnimationFrame(() => {
        requestAnimationFrame(() => overlay.classList.add("is-open"));
        searchInput.focus();
      });
    };

    const closeMenu = () => {
      overlay.classList.remove("is-open");
      overlay.classList.add("closing");
      trigger.setAttribute("aria-expanded", "false");
      closeTimer = window.setTimeout(() => {
        overlay.hidden = true;
        overlay.classList.remove("closing");
        closeTimer = null;
      }, 200);
    };

    let closeTimer: number | null = null;

    trigger.addEventListener("click", () => {
      if (overlay.hidden) openMenu();
      else closeMenu();
    });

    closeButton.addEventListener("click", closeMenu);
    searchInput.addEventListener("input", filterLinks);
    overlay.addEventListener("mousedown", closeMenu);
    dialog.addEventListener("mousedown", (event) => event.stopPropagation());

    document.addEventListener("keydown", (event) => {
      if (event.key.toLowerCase() === "j" && (event.metaKey || event.ctrlKey)) {
        event.preventDefault();
        if (overlay.hidden) openMenu();
        else closeMenu();
      }

      if (event.key === "Escape") closeMenu();
    });
  });
</script>
