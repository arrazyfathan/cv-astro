---
import DownloadPdfPopover from "./DownloadPdfPopover.astro";
import Icon from "./Icon.astro";
import { PDF_FILES, UI_COPY } from "@/data/resume";

interface CommandLink {
  title: string;
  url: string;
}

interface Props {
  name: string;
  location: string;
  email: string | null;
  links: CommandLink[];
}

const { name, location, email, links } = Astro.props;
---

<div data-command-menu data-email={email ?? ""}>
  <footer class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-[var(--line)] pt-6 font-mono text-[12px] text-[var(--muted)] print:hidden">
    <span>{name} · {location}</span>

    <div class="flex items-center gap-3">
      <DownloadPdfPopover placement="top" size="xs" />
      <span aria-hidden="true" class="text-[var(--quiet)]">·</span>
      <button
        type="button"
        data-command-trigger
        aria-label="Open command menu"
        aria-controls="command-menu-dialog"
        aria-expanded="false"
        class="inline-flex cursor-pointer items-center gap-1.5 transition-colors hover:text-[var(--ink)]"
      >
        <Icon name="command" class="size-3" />
        <span>{UI_COPY.en.menu.button}</span>
        <kbd
          data-command-shortcut
          class="rounded border border-[var(--line-strong)] bg-[var(--sunken)] px-1.5 py-0.5 text-[10.5px] font-medium text-[var(--ink-2)]"
        >
          ⌘J
        </kbd>
      </button>
    </div>
  </footer>

  <div
    class="cmd-overlay fixed inset-0 z-50 flex items-start justify-center bg-black/45 px-4 pt-[14vh] backdrop-blur-[2px] print:hidden"
    role="presentation"
    hidden
    data-command-overlay
  >
    <div
      id="command-menu-dialog"
      class="cmd-dialog w-full max-w-lg overflow-hidden rounded-xl border border-[var(--line-strong)] bg-[var(--surface)] text-[var(--ink)] shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-label="Command menu"
      data-command-dialog
    >
      <div class="flex items-center border-b border-[var(--line)] px-3.5">
        <Icon name="search" class="mr-2.5 size-4 shrink-0 text-[var(--muted)]" />
        <input
          class="h-12 w-full bg-transparent text-sm text-[var(--ink)] outline-none placeholder:text-[var(--muted)]"
          placeholder={UI_COPY.en.menu.searchPlaceholder}
          data-placeholder-en={UI_COPY.en.menu.searchPlaceholder}
          data-placeholder-id={UI_COPY.id.menu.searchPlaceholder}
          autocomplete="off"
          data-command-search
        />
        <button
          type="button"
          class="cursor-pointer rounded-md p-1 text-[var(--muted)] transition-colors hover:bg-[var(--sunken)] hover:text-[var(--ink)]"
          aria-label="Close command menu"
          data-command-close
        >
          <Icon name="x" class="size-4" />
        </button>
      </div>

      <div class="max-h-[380px] overflow-y-auto p-2">
        <div data-group-actions>
          <div class="px-2.5 py-1.5 font-mono text-[11px] font-medium uppercase tracking-wider text-[var(--muted)]">
            <span data-lang-view="en">{UI_COPY.en.menu.actions}</span>
            <span data-lang-view="id">{UI_COPY.id.menu.actions}</span>
          </div>
          <a
            href={PDF_FILES.en.href}
            download={PDF_FILES.en.filename}
            data-command-item
            data-command-title="download unduh pdf resume english en"
            data-action-download
            class="flex w-full items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-sm text-[var(--ink)] transition-colors hover:bg-[var(--sunken)]"
          >
            <Icon name="download" class="size-4 text-[var(--muted)]" />
            <span data-lang-view="en">{UI_COPY.en.menu.downloadEn}</span>
            <span data-lang-view="id">{UI_COPY.id.menu.downloadEn}</span>
          </a>
          <a
            href={PDF_FILES.id.href}
            download={PDF_FILES.id.filename}
            data-command-item
            data-command-title="download unduh pdf resume bahasa indonesia id"
            data-action-download
            class="flex w-full items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-sm text-[var(--ink)] transition-colors hover:bg-[var(--sunken)]"
          >
            <Icon name="download" class="size-4 text-[var(--muted)]" />
            <span data-lang-view="en">{UI_COPY.en.menu.downloadId}</span>
            <span data-lang-view="id">{UI_COPY.id.menu.downloadId}</span>
          </a>
          <button
            type="button"
            data-command-item
            data-command-title="print cetak save simpan pdf"
            data-action-print
            class="flex w-full cursor-pointer items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-sm text-[var(--ink)] transition-colors hover:bg-[var(--sunken)]"
          >
            <Icon name="printer" class="size-4 text-[var(--muted)]" />
            <span data-lang-view="en">{UI_COPY.en.menu.print}</span>
            <span data-lang-view="id">{UI_COPY.id.menu.print}</span>
          </button>
          {email && (
            <button
              type="button"
              data-command-item
              data-command-title={`copy salin email ${email}`}
              data-action-copy
              class="flex w-full cursor-pointer items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-sm text-[var(--ink)] transition-colors hover:bg-[var(--sunken)]"
            >
              <Icon name="copy" class="size-4 text-[var(--muted)]" />
              <span data-lang-view="en">{UI_COPY.en.menu.copyEmail} ({email})</span>
              <span data-lang-view="id">{UI_COPY.id.menu.copyEmail} ({email})</span>
            </button>
          )}
          <button
            type="button"
            data-command-item
            data-command-title="switch ganti language bahasa indonesia english en id"
            data-action-language
            class="flex w-full cursor-pointer items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-sm text-[var(--ink)] transition-colors hover:bg-[var(--sunken)]"
          >
            <Icon name="globe" class="size-4 text-[var(--muted)]" />
            <span data-lang-view="en">{UI_COPY.en.menu.toggleLanguage}</span>
            <span data-lang-view="id">{UI_COPY.id.menu.toggleLanguage}</span>
          </button>
          <button
            type="button"
            data-command-item
            data-command-title="toggle ganti light dark terang gelap theme tema"
            data-action-theme
            class="flex w-full cursor-pointer items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-sm text-[var(--ink)] transition-colors hover:bg-[var(--sunken)]"
          >
            <Icon name="moon" class="size-4 text-[var(--muted)]" />
            <span data-lang-view="en">{UI_COPY.en.menu.toggleTheme}</span>
            <span data-lang-view="id">{UI_COPY.id.menu.toggleTheme}</span>
          </button>
        </div>

        <div class="mt-2 border-t border-[var(--line)] pt-2" data-group-links>
          <div class="px-2.5 py-1.5 font-mono text-[11px] font-medium uppercase tracking-wider text-[var(--muted)]">
            <span data-lang-view="en">{UI_COPY.en.menu.links}</span>
            <span data-lang-view="id">{UI_COPY.id.menu.links}</span>
          </div>
          {links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              data-command-item
              data-command-title={link.title.toLowerCase()}
              class="flex w-full items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-sm text-[var(--ink)] transition-colors hover:bg-[var(--sunken)]"
            >
              <Icon name="arrow-up-right" class="size-4 text-[var(--muted)]" />
              <span>{link.title}</span>
            </a>
          ))}
        </div>

        <p class="px-2 py-6 text-center text-sm text-[var(--muted)]" hidden data-command-empty>
          <span data-lang-view="en">{UI_COPY.en.menu.empty}</span>
          <span data-lang-view="id">{UI_COPY.id.menu.empty}</span>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  const menus = document.querySelectorAll<HTMLElement>("[data-command-menu]");

  menus.forEach((menu) => {
    const trigger = menu.querySelector<HTMLButtonElement>("[data-command-trigger]");
    const overlay = menu.querySelector<HTMLElement>("[data-command-overlay]");
    const dialog = menu.querySelector<HTMLElement>("[data-command-dialog]");
    const closeButton = menu.querySelector<HTMLButtonElement>("[data-command-close]");
    const searchInput = menu.querySelector<HTMLInputElement>("[data-command-search]");
    const emptyState = menu.querySelector<HTMLElement>("[data-command-empty]");
    const shortcutEl = menu.querySelector<HTMLElement>("[data-command-shortcut]");
    const items = Array.from(menu.querySelectorAll<HTMLElement>("[data-command-item]"));
    const actionPrint = menu.querySelector<HTMLButtonElement>("[data-action-print]");
    const actionDownloads = Array.from(menu.querySelectorAll<HTMLAnchorElement>("[data-action-download]"));
    const actionCopy = menu.querySelector<HTMLButtonElement>("[data-action-copy]");
    const actionLanguage = menu.querySelector<HTMLButtonElement>("[data-action-language]");
    const actionTheme = menu.querySelector<HTMLButtonElement>("[data-action-theme]");
    const email = menu.dataset.email ?? "";

    if (!trigger || !overlay || !dialog || !closeButton || !searchInput || !emptyState) return;

    const isMac = window.navigator.userAgent.includes("Mac");
    if (shortcutEl) shortcutEl.textContent = isMac ? "⌘J" : "Ctrl+J";

    const syncSearchPlaceholder = () => {
      const isId = document.documentElement.dataset.lang === "id";
      searchInput.placeholder =
        (isId ? searchInput.dataset.placeholderId : searchInput.dataset.placeholderEn) ?? "";
    };

    syncSearchPlaceholder();
    window.addEventListener("cv:lang-sync", syncSearchPlaceholder);

    let closeTimer: number | null = null;

    const filterItems = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      items.forEach((item) => {
        const matches = !query || (item.dataset.commandTitle ?? "").includes(query);
        item.hidden = !matches;
        if (matches) visibleCount += 1;
      });

      emptyState.hidden = visibleCount !== 0;
    };

    const openMenu = () => {
      if (closeTimer !== null) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      overlay.classList.remove("closing");
      overlay.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      searchInput.value = "";
      syncSearchPlaceholder();
      filterItems();
      requestAnimationFrame(() => {
        requestAnimationFrame(() => overlay.classList.add("is-open"));
        searchInput.focus();
      });
    };

    const closeMenu = () => {
      overlay.classList.remove("is-open");
      overlay.classList.add("closing");
      trigger.setAttribute("aria-expanded", "false");
      closeTimer = window.setTimeout(() => {
        overlay.hidden = true;
        overlay.classList.remove("closing");
        closeTimer = null;
      }, 180);
    };

    trigger.addEventListener("click", () => {
      if (overlay.hidden) openMenu();
      else closeMenu();
    });

    closeButton.addEventListener("click", closeMenu);
    searchInput.addEventListener("input", filterItems);
    overlay.addEventListener("mousedown", closeMenu);
    dialog.addEventListener("mousedown", (e) => e.stopPropagation());

    actionPrint?.addEventListener("click", () => {
      closeMenu();
      window.setTimeout(() => window.print(), 120);
    });

    actionDownloads.forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    actionCopy?.addEventListener("click", () => {
      closeMenu();
      if (email) navigator.clipboard?.writeText(email);
    });

    actionLanguage?.addEventListener("click", () => {
      closeMenu();
      window.dispatchEvent(new CustomEvent("cv:lang-toggle"));
    });

    actionTheme?.addEventListener("click", () => {
      closeMenu();
      const nextDark = document.documentElement.classList.toggle("dark");
      try {
        sessionStorage.setItem("cv-theme", nextDark ? "dark" : "light");
      } catch {
        // Ignore storage errors.
      }
      window.dispatchEvent(new CustomEvent("cv:theme-sync"));
    });

    document.addEventListener("keydown", (event) => {
      const k = event.key.toLowerCase();
      if ((k === "j" || k === "k") && (event.metaKey || event.ctrlKey)) {
        event.preventDefault();
        if (overlay.hidden) openMenu();
        else closeMenu();
      }
      if (event.key === "Escape" && !overlay.hidden) {
        closeMenu();
      }
    });
  });
</script>
