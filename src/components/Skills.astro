---
import Section from "./Section.astro";
import type { ResumeData } from "@/data/resume";

interface Props {
  skills: ResumeData["skills"];
}

const { skills } = Astro.props;

const groups = [
  { label: "Languages", items: skills.programmingLanguages },
  { label: "Mobile", items: skills.mobile },
  { label: "Tools", items: skills.toolbox },
];
---

<Section title="Skills" id="skills-section" delay="200ms">
  <div class="space-y-4 print:space-y-2" aria-labelledby="skills-section">
    {groups.map((group) => (
      <div class="cv-avoid-break grid grid-cols-1 gap-y-2 sm:grid-cols-[116px_1fr] sm:items-start sm:gap-x-5 print:grid-cols-[96px_1fr] print:gap-x-4">
        <h3 class="font-mono text-[12px] font-medium text-[var(--muted)] sm:pt-1 print:pt-0.5 print:text-[10px]">
          {group.label}
        </h3>
        <ul class="flex flex-wrap gap-1.5 print:gap-1" aria-label={`${group.label} skills`}>
          {group.items.map((skill) => (
            <li class="rounded-md border border-[var(--line)] bg-[var(--sunken)] px-2.5 py-0.5 text-[12.5px] font-medium text-[var(--ink-2)] transition-colors hover:border-[var(--line-strong)] hover:text-[var(--ink)] print:px-1.5 print:py-0 print:text-[9.5px]">
              {skill}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
